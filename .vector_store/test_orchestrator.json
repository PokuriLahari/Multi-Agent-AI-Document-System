258064516129, "parent.": 0.004032258064516129, "increase": 0.004032258064516129, "resulting": 0.004032258064516129, "tree": 0.004032258064516129, "6.": 0.004032258064516129, "continue": 0.004032258064516129, "until": 0.004032258064516129, "no": 0.004032258064516129, "7.": 0.004032258064516129, "return": 0.004032258064516129, "updated": 0.004032258064516129, "heap.": 0.004032258064516129}, "source_file": "my_document.pdf", "page_number": 1}, {"id": "ee25123e-ebd1-4447-ba7b-3247222bc7e5", "text": "Algorithm: EXTRACT-MIN() in Binomial Heap \nInput: A binomial heap H \nOutput: Minimum key element or EMPTY \n1. If the heap is empty, return EMPTY. \n2. Traverse the root list of the heap to find the root with the minimum key. \n3. Remove this minimum root from the root list. \n4. Take the child list of the removed root and reverse its order. \n5. Set the parent of all these child nodes to NULL. \n6. Create a new binomial heap H₂ using the reversed child list. \n7. Merge heap H₂ with the remaining heap using the union operation. \n8. Return the minimum key that was removed. \n \nExamples : \nTake from class notes  example like insertion ,extract -min and decrease Key \nProgram: \n \nWrite your own code \nTest cases: \n", "embedding": {"algorithm:": 0.007936507936507936, "extract-min()": 0.007936507936507936, "in": 0.007936507936507936, "binomial": 0.023809523809523808, "heap": 0.05555555555555555, "input:": 0.007936507936507936, "a": 0.015873015873015872, "h": 0.007936507936507936, "output:": 0.007936507936507936, "minimum": 0.031746031746031744, "key": 0.023809523809523808, "element": 0.007936507936507936, "or": 0.007936507936507936, "empty": 0.007936507936507936, "1.": 0.007936507936507936, "if": 0.007936507936507936, "the": 0.10317460317460317, "is": 0.007936507936507936, "empty,": 0.007936507936507936, "return": 0.015873015873015872, "empty.": 0.007936507936507936, "2.": 0.007936507936507936, "traverse": 0.007936507936507936, "root": 0.03968253968253968, "list": 0.01587